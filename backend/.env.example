# Copy this file to ".env" and fill in your own values.
# The .env file should NEVER be uploaded to GitHub (it's already in .gitignore).

# REQUIRED for TEXT detection: a free Sapling.ai API key.
# Get one at https://sapling.ai/ — sign up for a free account, then
# generate a developer API key from your dashboard. The free tier allows
# 50,000 characters of detection per 24 hours, no credit card needed.
SAPLING_API_KEY=

# REQUIRED for IMAGE and VIDEO detection: a free Hugging Face API token.
# Get one at https://huggingface.co/settings/tokens (free account required,
# no credit card needed). Click "New token", choose the "Read" role, and
# paste the value here.
HUGGINGFACE_API_TOKEN=

# Port the Flask server runs on locally
PORT=5000
