# Copy this file to ".env" and fill in your own values.
# The .env file should NEVER be uploaded to GitHub (it's already in .gitignore).

# REQUIRED: a free Hugging Face API token.
# Get one at https://huggingface.co/settings/tokens (free account required,
# no credit card needed). Click "New token", choose the "Read" role, and
# paste the value here.
#
# This app now uses real AI models (via Hugging Face's free Inference API)
# for every detection type, so this token must be set or detection will
# not work.
HUGGINGFACE_API_TOKEN=

# Port the Flask server runs on locally
PORT=5000
