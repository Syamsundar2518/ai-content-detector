# Copy this file to ".env" and fill in your own values.
# The .env file should NEVER be uploaded to GitHub (it's already in .gitignore).

# Optional: a free Hugging Face API token.
# Get one at https://huggingface.co/settings/tokens (free account required).
# If you leave this blank, the app still works — it will just use the
# built-in offline (heuristic) detectors instead of the online AI models.
HUGGINGFACE_API_TOKEN=

# Port the Flask server runs on locally
PORT=5000
